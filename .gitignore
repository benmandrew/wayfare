# Everything the pipeline downloads or builds. Tens of gigabytes.
# The glob, not a bare `data/`: each region gets its own data root, and
# `data-london/` was committed once because only `data/` was listed here.
data/
data-*/
*.pmtiles
*.duckdb
*.duckdb.wal
*.osm.pbf
*.part

.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Claude Code's session state, and the git worktrees it creates under here.
.claude/

.env
.DS_Store

# direnv/nix-direnv: the devShell it builds, and the gc root that keeps it.
.direnv/
