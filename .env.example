# Copy to .env. Compose reads it automatically.

# --- Area -------------------------------------------------------------------
# WAYFARE_REGION and WAYFARE_OSM_URL must describe the same area. They are set
# separately because BODS splits Britain far more finely than Geofabrik does, and
# a mismatch is not detected -- the matcher would simply ask a Welsh road graph
# about Yorkshire stops and fail every pattern.

# National (default): 1.28 GB feed, 2.16 GB extract, ~40 GB of disk in total.
#WAYFARE_REGION=all
#WAYFARE_OSM_URL=https://download.geofabrik.de/europe/great-britain-latest.osm.pbf

# Wales -- 41 MB feed, 146 MB extract. The right size for a first run.
#WAYFARE_REGION=wales
#WAYFARE_OSM_URL=https://download.geofabrik.de/europe/united-kingdom/wales-latest.osm.pbf

# Other BODS regions: england, scotland, north_east, north_west, yorkshire,
# east_midlands, west_midlands, east_anglia, london, south_east, south_west.
# Geofabrik has no separate extract for most of them, so use great-britain.

# --- Resources --------------------------------------------------------------
# Matching is entirely I/O-bound on Valhalla, so this scales close to linearly
# with cores until Valhalla itself saturates.
#WAYFARE_WORKERS=6
#VALHALLA_THREADS=8

# DuckDB's limit for the group-by over stop_times.txt (5.09 GB nationally). It
# spills to disk beyond this rather than failing.
#WAYFARE_MEM=8GB

# --- Image ------------------------------------------------------------------
# The published image, built and pushed by .github/workflows/image.yml. Override
# it to pin a tag (benmandrew/wayfare:v0.1.0, or a commit sha) or to run a
# locally built one:
#
#   docker build -t benmandrew/wayfare:dev .
#
#WAYFARE_IMAGE=benmandrew/wayfare:latest

# --- Serving ----------------------------------------------------------------
#WEB_PORT=8099

# /art renders on the server, against the database the pipeline already built, so a
# design can be iterated on without a copy of the data. It is the one endpoint that
# costs real CPU: serving tiles is reading bytes off disk, and a render is a scan of
# `edges` plus cairo. Set this to `off` where the port reaches people you would not
# hand a core to; the endpoint then answers 501 and the studio page explains why.
#
# Renders are bounded regardless: one at a time, four queued, 64 megapixels.
#WAYFARE_ART=off
